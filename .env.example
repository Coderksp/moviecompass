# Get a free API key at https://www.themoviedb.org/settings/api
# Then copy this file to ".env" and paste your key below.
#
# No VITE_ prefix: this is read by the serverless proxy in /api and stays on the
# server. Anything prefixed VITE_ is substituted into the browser bundle at build
# time, which would publish the key to every visitor.
TMDB_API_KEY=your_tmdb_api_key_here

# Optional, local development only. Some ISPs block themoviedb.org, and the proxy
# can't help when it runs on the machine that's blocked. Point this at your
# deployed site to route local requests through a proxy that isn't blocked:
#   VITE_API_ORIGIN=https://your-project.vercel.app
# Leave it unset in production.
VITE_API_ORIGIN=

# Optional. Ranks an actor's films by IMDb rating rather than TMDB's, which is
# far better sampled for regional cinema — a defining Tamil film may carry 74
# votes on TMDB against tens of thousands on IMDb.
# Free self-serve key: https://www.omdbapi.com/apikey.aspx
# Server-only, so no VITE_ prefix. Leave blank and the app falls back to a
# TMDB-based public-opinion score.
OMDB_API_KEY=

# Optional. Writes the one-line "why you might like this" captions under each
# title in the "More like this" rail.
#
# The recommendations themselves do not depend on this. Ranking is done by the
# model in api/_lib/recommend.js, which needs no key and no network beyond TMDB;
# Claude only puts the connection it found into a readable sentence. Leave this
# blank and the captions are assembled from the matched features instead
# ("Directed by Lokesh Kanagaraj · lokesh cinematic universe"), which is plainer
# but never wrong.
#
# Get a key at https://console.anthropic.com/settings/keys
# Server-only, so no VITE_ prefix — this must never reach the browser bundle.
ANTHROPIC_API_KEY=
